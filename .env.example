# ============================================================
# 环境变量模板 —— 复制成 .env 后填自己的值：
#   Windows:      copy .env.example .env
#   macOS/Linux:  cp .env.example .env
# .env 已在 .gitignore 里，不会被提交。这里只放示例值，不要写真实密钥。
# ============================================================

# ---------- 大模型 ----------
# DeepSeek 控制台申请：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 兼容 OpenAI SDK 的接口地址与模型名，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ---------- MySQL ----------
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
# 与 sql/00_init.sql 里建的库名保持一致
DB_NAME=taobao_analysis

# ---------- Agent 行为参数 ----------
# 不暴露给模型的列，格式 表名.列名，多个用英文逗号分隔。
# user_behavior.behavior_count 是老表的遗留列（全为 0），模型一旦选中就会得出错误结论。
HIDDEN_COLUMNS=user_behavior.behavior_count
# 回传给前端（表格展示 + CSV 导出）的最大行数
MAX_ROWS_RETURN=200
# SQL 护栏强制的最大返回行数，超过会被截断
SQL_HARD_LIMIT=1000
# SQL 执行失败后回传错误让模型自愈重试的最大次数（评估脚本也遵循这个上限）
MAX_SQL_RETRY=2

# ---------- 服务 ----------
# 默认 8000，前端 index.html 的回连地址也是 8000，改这里要同步改前端
PORT=8000
